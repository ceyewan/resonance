{
  "uid": "resonance-overview",
  "title": "Resonance Overview",
  "tags": ["resonance", "local-v1"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Core targets up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"resonance\"})", "legendFormat": "up" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway QPS / errors",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_http_requests_total[1m]))",
          "legendFormat": "requests/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gateway_http_errors_total[1m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Message push P95 / P99",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_push_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gateway_push_duration_seconds_bucket[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Live service logs",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{deployment_environment=\"local-v1\",service_name=~\"logic|gateway|task|pilot\"}"
        }
      ]
    }
  ]
}
