# ============================================================================
# Resonance 环境变量示例（同时用于 Compose 和应用运行时）
# ============================================================================
# 使用方式：
#   1) cp .env.example .env
#   2) 修改本文件中的变量
#   3) docker compose / make up 读取 .env。Pilot 控制面和 Runtime 只显式
#      注入各自所需变量，不会把整个 .env 传入安全边界。
#
# 配置优先级（容器内）：
#   运行时环境变量 > configs/{service}.yaml
# ============================================================================

# 调试配置打印
RESONANCE_DEBUG_CONFIG=false

# ============================================================================
# Compose 编排变量
# ============================================================================
RESONANCE_IMAGE=ceyewan/resonance:local
RESONANCE_PILOT_IMAGE=ceyewan/resonance-pilot:local
RESONANCE_PILOT_RUNTIME_IMAGE=ceyewan/resonance-pilot-runtime:local

# 生产 Agent 发布必须将上述两项替换为同一发布产物中记录的
# repository@sha256:<64 hex> 不变引用。回滚脚本只读取下面两项：
# PILOT_PREVIOUS_IMAGE_DIGEST=ceyewan/resonance-pilot@sha256:<64 hex>
# PILOT_RUNTIME_PREVIOUS_IMAGE_DIGEST=ceyewan/resonance-pilot-runtime@sha256:<64 hex>

# 挂载配置目录到容器 /app/configs（修改后重启容器即可生效）
RESONANCE_CONFIG_DIR=../configs

# 本地端口映射（生产建议留空，交给 Caddy）
GATEWAY_PORT_BINDING=127.0.0.1:8080:8080
WEB_PORT_BINDING=127.0.0.1:4173:4173

# 反向代理域名
CADDY_GATEWAY_DOMAIN=im-api.ceyewan.xyz
CADDY_WEB_DOMAIN=ceyewan.xyz

# Compose 容器 hostname（用于多实例命名）
RESONANCE_GATEWAY_HOSTNAME=gateway-service-001
RESONANCE_LOGIC_HOSTNAME=logic-service-001
RESONANCE_TASK_HOSTNAME=task-service-001
RESONANCE_WEB_HOSTNAME=web-service-001

# ============================================================================
# 基础设施与业务敏感配置（生产必须修改）
# ============================================================================
RESONANCE_POSTGRES_DATABASE=resonance
RESONANCE_POSTGRES_USER=resonance
RESONANCE_POSTGRES_PASSWORD=resonance123

# JWT
RESONANCE_AUTH_SECRET_KEY=replace-with-strong-secret-at-least-32-chars
RESONANCE_AUTH_ISSUER=resonance-service
RESONANCE_AUTH_ACCESS_TOKEN_TTL=24h

# Gateway -> Logic 每请求、载荷绑定的服务签名（与 JWT 密钥分离）
RESONANCE_GATEWAY_SERVICE_AUTH_SECRET=replace-with-distinct-random-secret-at-least-32-chars

# Profile-specific Pilot credentials. IAM values must not reuse the
# user-assistant values; Logic service allowlists must be configured together.
RESONANCE_PILOT_CAPABILITY_SECRET=replace-with-user-assistant-capability-secret
RESONANCE_PILOT_SERVICE_AUTH_ID=pilot-service
RESONANCE_PILOT_SERVICE_AUTH_SECRET=replace-with-user-assistant-service-secret
RESONANCE_PILOT_IAM_CAPABILITY_SECRET=replace-with-iam-admin-capability-secret
RESONANCE_PILOT_IAM_SERVICE_AUTH_ID=pilot-iam-admin-service
RESONANCE_PILOT_IAM_SERVICE_AUTH_SECRET=replace-with-iam-admin-service-secret
RESONANCE_PILOT_TENANT_ID=default
RESONANCE_PILOT_IAM_TENANT_ID=default
RESONANCE_USER_ASSISTANT_PROFILE_VERSION=1
RESONANCE_IAM_ADMIN_PROFILE_VERSION=1

# 阿里云百炼 OpenAI-compatible 配置。真实 Key 只注入隔离的 Pi Runtime
# sidecar；Pilot 控制面、Logic、Gateway 和 Web 都不得读取此值。
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://llm-3rwbpx52jtt7759p.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max

# 默认 Tenant 的初始 Agent 预算。init 仅在策略不存在时创建，不会在重启时
# 覆盖已有策略。金额单位为 micro-USD；上线前应结合 Provider 账单校准。
RESONANCE_AGENT_BUDGET_TENANT_ID=default
RESONANCE_AGENT_BUDGET_ENABLED=true
RESONANCE_AGENT_BUDGET_DAILY_TOKEN_LIMIT=2000000
RESONANCE_AGENT_BUDGET_MONTHLY_TOKEN_LIMIT=20000000
RESONANCE_AGENT_BUDGET_DAILY_COST_LIMIT_MICROS=50000000
RESONANCE_AGENT_BUDGET_MONTHLY_COST_LIMIT_MICROS=500000000
RESONANCE_AGENT_BUDGET_MAX_ATTEMPT_TOKENS=65536
RESONANCE_AGENT_BUDGET_MAX_ATTEMPT_COST_MICROS=10000000

# init 模块管理员
RESONANCE_ADMIN_USERNAME=ceyewan
RESONANCE_ADMIN_PASSWORD=admin123
RESONANCE_ADMIN_NICKNAME=管理员

# ============================================================================
# 运行时可调参数（可选）
# ============================================================================
RESONANCE_REGISTRY_NAMESPACE=/resonance/services
RESONANCE_REGISTRY_DEFAULT_TTL=30s
RESONANCE_REGISTRY_ENABLE_CACHE=true

RESONANCE_LOG_FORMAT=json
RESONANCE_LOG_OUTPUT=stdout
RESONANCE_LOG_LEVEL=info

# ============================================================================
# Web 前端运行时配置（可选，由 webserver /runtime-config.js 注入浏览器）
# ============================================================================
# 为空时：
#   apiBaseUrl = "" → 前端走同源调用
#   wsBaseUrl  = "" → 前端走同源 /ws
# 单域名同源部署（生产 Caddy 反代 gateway 到 web 同域）：留空即可。
# 双域名部署（如 web=ceyewan.xyz, api=im-api.ceyewan.xyz）必须显式设置：
#   RESONANCE_WEB_API_BASE_URL=https://im-api.ceyewan.xyz
#   RESONANCE_WEB_WS_BASE_URL=wss://im-api.ceyewan.xyz/ws
# 开发期（vite dev）不读这两个变量，由 vite.config.ts 的 server.proxy 兜底。
RESONANCE_WEB_API_BASE_URL=
RESONANCE_WEB_WS_BASE_URL=
